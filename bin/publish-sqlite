#!/usr/bin/env sh
# Publishes an empty 0.0.0 of @wirecat/cli-core-sqlite and of each of its platform packages once, so each
# name exists, then makes each name trust GitHub Actions (WireCatLabs/cli-core, workflow sqlite.yml,
# environment npm). npm asks you to sign in and confirm in the browser for that. Every version with
# libraries is published by that workflow, never from this machine. A name already on npm, or already
# trusting the workflow, is skipped, so the script can run again after a failure.
#
#   bin/publish-sqlite
set -eu

packages="@wirecat/cli-core-sqlite
@wirecat/cli-core-sqlite-darwin
@wirecat/cli-core-sqlite-linux-x64-gnu
@wirecat/cli-core-sqlite-linux-arm64-gnu
@wirecat/cli-core-sqlite-linux-x64-musl
@wirecat/cli-core-sqlite-linux-arm64-musl
@wirecat/cli-core-sqlite-win32-x64"

missing=""
for package in $packages; do
  if npm view "$package" version >/dev/null 2>&1; then
    echo "$package is already on npm"
  else
    missing="$missing $package"
  fi
done
publish_missing() {
if [ -z "${NPM_TOKEN:-}" ]; then
  NPM_TOKEN=$(secret-tool lookup service npm account leemour 2>/dev/null) || {
    echo "no npm token: export NPM_TOKEN, or store one with: secret-tool store --label=npm service npm account leemour" >&2
    exit 1
  }
fi
[ -n "$NPM_TOKEN" ] || { echo "the npm token is empty" >&2; exit 1; }
export NPM_TOKEN

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
# A config that names the variable, not the value: the token stays in the environment.
printf '//registry.npmjs.org/:_authToken=${NPM_TOKEN}\n' > "$work/.npmrc"
for package in $missing; do
  rm -f "$work/package.json"
  cat > "$work/package.json" <<JSON
{
  "name": "$package",
  "version": "0.0.0",
  "description": "Placeholder: the SQLite builds for @wirecat/cli-core are published from CI",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/WireCatLabs/cli-core.git", "directory": "packages/sqlite" }
}
JSON
  (cd "$work" && npm publish --access public --userconfig "$work/.npmrc")
  echo "published $package@0.0.0"
done
}
[ -z "$missing" ] || (publish_missing)

# A token in ~/.npmrc that bypasses 2FA cannot change trust (npm answers 401), so trust runs as you, signed in.
if ! npm whoami >/dev/null 2>&1; then
  echo "npm does not know you on this computer. Open the link npm prints and sign in."
  npm login --auth-type=web --browser=false
fi
for package in $packages; do
  if npm trust list "$package" 2>/dev/null | grep -q "sqlite.yml"; then
    echo "OK    $package already trusts sqlite.yml"
    continue
  fi
  echo "$package → WireCatLabs/cli-core, sqlite.yml, environment npm. Open the link npm prints and confirm."
  npm trust github "$package" --file sqlite.yml --repository WireCatLabs/cli-core --environment npm \
    --allow-publish --yes --browser=false
done
echo "done: tell Claude, it runs the SQLite workflow with publish"
