#!/usr/bin/env sh
# Publishes the version in package.json and tags it. Run on a clean `main`. When npm already has that
# version, or a higher one, it commits the next free version to `main`, with the CHANGELOG heading
# renamed to match, and publishes that.
#
#   bin/release           # publishes from GitHub Actions (.github/workflows/release.yml)
#   bin/release --local   # publishes from this machine with the npm token from the keyring
#
# The npm token is never printed — not on success, not in an error.
set -eu

cd "$(dirname "$0")/.."

mode=ci
case "${1:-}" in
  "") ;;
  --local) mode=local ;;
  *) echo "usage: bin/release [--local]" >&2; exit 2 ;;
esac

git fetch -q origin
[ "$(git branch --show-current)" = "main" ] || { echo "not on main" >&2; exit 1; }
[ -z "$(git status --porcelain --untracked-files=no)" ] || { echo "uncommitted changes" >&2; exit 1; }
before=$(git rev-parse HEAD)
git merge -q --ff-only origin/main
# The shell keeps running the file it read before the merge; max-cli published with a stale copy.
[ "$(git rev-parse HEAD)" = "$before" ] || exec "$0" "$@"
# The workflow publishes origin/main, so a local commit not pushed yet would silently not ship.
[ "$(git rev-parse HEAD)" = "$(git rev-parse origin/main)" ] || { echo "main is ahead of origin/main — push first" >&2; exit 1; }

version=$(node -p 'require("./package.json").version')
# Only the top section: the rename below must never touch one that is already published.
top=$(grep -m1 '^## ' CHANGELOG.md || true)
case "$top" in
  "## $version — "*) ;;
  *) echo "CHANGELOG.md's top section is \"$top\" — date it as $version first" >&2; exit 1 ;;
esac
# `npm view` rather than the registry document, which a CDN serves stale for minutes.
published() {
  npm view "@leemour/cli-core@$version" version --prefer-online >/dev/null 2>&1
}

# Two sessions preparing the same number is normal; the second takes the next free one (2026-09-29).
latest=$(npm view @leemour/cli-core version --prefer-online 2>/dev/null || true)
versions=$(npm view @leemour/cli-core versions --json --prefer-online 2>/dev/null || true)
next=$(node scripts/next-version.mjs "$version" "$latest" "$versions")
if [ "$next" != "$version" ]; then
  if published; then why="$version is already on npm"; else why="$version is not above npm's latest $latest"; fi
  echo "$why — publishing $next instead"
  node -e 'const fs = require("fs"); const [o, n] = process.argv.slice(1)
    const swaps = [["package.json", `"version": "${o}"`, `"version": "${n}"`], ["CHANGELOG.md", `\n## ${o} — `, `\n## ${n} — `]]
    const texts = swaps.map(([file, from]) => {
      const text = fs.readFileSync(file, "utf8")
      if (!text.includes(from)) { console.error(`${file} has no ${from.trim()}`); process.exit(1) }
      return text
    })
    swaps.forEach(([file, from, to], i) => fs.writeFileSync(file, texts[i].replace(from, to)))' "$version" "$next"
  git commit -q -am "chore: release $next" -m "bin/release: $why."
  git push -q origin main || {
    git reset -q --hard HEAD~1
    echo "main moved on origin while raising the version — run bin/release again" >&2
    exit 1
  }
  version=$next
fi
if published; then
  echo "$version is already on npm — raise the version first" >&2
  exit 1
fi

if [ "$mode" = ci ]; then
  last_run() {
    gh run list --workflow release.yml --branch main --event workflow_dispatch --limit 1 \
      --json databaseId --jq '.[0].databaseId // ""'
  }
  previous=$(last_run)
  echo "== starting the release workflow for $version =="
  gh workflow run release.yml --ref main
  run=""
  for _ in $(seq 30); do
    run=$(last_run)
    [ -n "$run" ] && [ "$run" != "$previous" ] && break
    run=""
    sleep 2
  done
  [ -n "$run" ] || { echo "the release workflow did not start within a minute — see gh run list --workflow release.yml" >&2; exit 1; }
  gh run watch "$run" --exit-status
  git fetch -q --tags origin
  echo "published @leemour/cli-core@$version"
  exit 0
fi

echo "== checks for $version =="
pnpm install --frozen-lockfile
pnpm lint && pnpm typecheck && pnpm test
pnpm build && pnpm smoke:bun

token=$(secret-tool lookup service npm account leemour) || { echo "no npm token in the keyring (service=npm account=leemour)" >&2; exit 1; }
[ -n "$token" ] || { echo "the keyring entry is empty" >&2; exit 1; }

echo "== publishing $version =="
NPM_TOKEN="$token" pnpm publish --access public --no-git-checks

echo "== waiting for npm to show $version (up to three minutes) =="
seen=""
for _ in $(seq 36); do
  if published; then seen=1; break; fi
  sleep 5
done
[ -n "$seen" ] || { echo "npm does not show $version after three minutes — not tagging; tag v$version by hand once it does" >&2; exit 1; }

echo "== tag v$version =="
git tag -a "v$version" -m "$version"
git push -q origin "v$version"
echo "published @leemour/cli-core@$version"
