#!/usr/bin/env sh
# Marks every version of each @leemour package as moved to its @wirecat name, once the @wirecat package has
# a real release (not only the 0.0.0 placeholder). Deprecated versions still install; npm prints the
# message. Never unpublishes. Safe to run again: it skips what is not ready and repeats what is.
#
#   bin/deprecate-leemour
set -eu

packages="cli-core cli-tasks cli-messaging cli-messaging-sqlite cli-messaging-onnx tg-cli max-cli cli-memo"

if [ -z "${NPM_TOKEN:-}" ]; then
  NPM_TOKEN=$(secret-tool lookup service npm account leemour 2>/dev/null) || {
    echo "no npm token: export NPM_TOKEN, or store one with: secret-tool store --label=npm service npm account leemour" >&2
    exit 1
  }
fi
[ -n "$NPM_TOKEN" ] || { echo "the npm token is empty" >&2; exit 1; }
export NPM_TOKEN

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
# A config that names the variable, not the value: the token stays in the environment.
printf '//registry.npmjs.org/:_authToken=${NPM_TOKEN}\n' > "$work/.npmrc"

for name in $packages; do
  latest=$(npm view "@wirecat/$name" version --prefer-online 2>/dev/null || true)
  case "$latest" in
    "" | 0.0.0) echo "waiting    @leemour/$name — @wirecat/$name has no release yet"; continue ;;
  esac
  npm deprecate "@leemour/$name" "Moved to @wirecat/$name: npm install @wirecat/$name" --userconfig "$work/.npmrc"
  echo "deprecated @leemour/$name → @wirecat/$name@$latest"
done
