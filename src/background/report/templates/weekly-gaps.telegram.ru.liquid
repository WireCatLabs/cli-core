{%- if items.size == 0 %}{{ nl }}{{ nl }}Пропусков не было.{% endif -%}
{%- for item in items -%}
  {{ nl }}{{ nl }}• {{ item.what }}
  {{- nl }}<i>{% if item.seen > 1 %}в {{ item.seen }} {% if item.plural == "one" %}сводке{% else %}сводках{% endif %}, последний раз {% endif %}{{ item.last.date }}</i>
  {%- for link in item.links %} · <a href="{{ link.url }}">{{ link.label }}</a>{% endfor -%}
{%- endfor -%}
