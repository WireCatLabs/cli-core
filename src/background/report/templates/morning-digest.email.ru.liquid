{%- comment -%}
Email HTML with inline CSS: only div, p, b, i, a, br and span survive, with a style attribute and an href to a link
of the view model. No colour on the body: the grey (#8a8a8a) and the link blue (#3b82c4) read on white and on dark.
{%- endcomment -%}
{%- capture nl %}
{% endcapture -%}
{%- assign weekdays = "понедельник,вторник,среду,четверг,пятницу,субботу,воскресенье" | split: "," -%}
{%- assign weekday = date.weekday | minus: 1 -%}
{%- assign muted = "color:#8a8a8a;font-size:13px" -%}
<div style="max-width:600px;font-family:-apple-system,Segoe UI,Roboto,Arial,sans-serif;font-size:15px">
{{- nl }}<p style="margin:0 0 8px;font-size:19px"><b>{{ emoji }} Сводка на {{ weekdays[weekday] }}, {{ date.date }}</b></p>
{%- if summary %}{{ nl }}<p style="margin:0 0 12px">{{ summary }}</p>{% endif -%}
{%- if quiet -%}
  {{ nl }}<p style="margin:0 0 12px">
  {%- if health.items.size > 0 %}Новых дел нет, но {{ health.items[0].source }} не обновлялся {{ health.items[0].span }}.
  {%- else %}Тихое утро: ничего срочного.{% endif %}</p>
{%- endif -%}
{%- for section in sections -%}
  {{ nl }}<p style="margin:20px 0 8px;font-size:17px"><b>{{ section.emoji }}{{ " " }}
  {%- case section.kind -%}
    {%- when "today" %}Сегодня
    {%- when "decisions" %}Ждут вашего решения
    {%- when "money" %}Деньги
    {%- when "meetings" %}Встречи
    {%- when "projects" %}Проекты в движении
    {%- when "mail" %}Новая почта
  {%- endcase %}</b></p>
  {%- for item in section.items -%}
    {%- capture due -%}
      {%- if item.due -%}
        {%- if item.overdue %}<b>просрочено на {{ item.due.span }}</b>
        {%- else %}срок {% if item.due.day == "today" %}сегодня{% elsif item.due.day == "tomorrow" %}завтра{% else %}{{ item.due.date }}{% endif %}{% if item.due.time %}, {{ item.due.time }}{% endif %}
        {%- endif -%}
      {%- endif -%}
    {%- endcapture -%}
    {{ nl }}<p style="margin:0 0 12px;line-height:1.45">{{ item.emoji }}{{ " " }}
    {%- case item.type -%}
      {%- when "reply" %}<b>{{ item.who }} · {{ item.topic }}</b> — {{ item.action }}
      {%- when "question" %}<b>{{ item.who }}</b> спрашивает: {{ item.action }}
      {%- when "task" %}<b>{{ item.topic }}</b> — {{ due }}
      {%- when "fact" %}<b>{{ item.topic }}</b>: {{ item.detail }}
      {%- when "risk" %}<b>{{ item.topic }}</b>: {{ item.detail }} → {{ item.action }}
      {%- when "money" %}<b>{{ item.amount.text }} · {{ item.who }} · {{ item.topic }}</b>{% if item.action %} — {{ item.action }}{% endif %}
      {%- when "decision" %}<b>{{ item.topic }}</b> — {% if item.count %}{{ item.count }} {% endif %}{{ item.action }}
      {%- when "meeting" %}<b>
        {%- if item.time.day == "today" %}{{ item.time.time }}
        {%- elsif item.time.day == "yesterday" %}Вчера
        {%- elsif item.time.day == "tomorrow" %}Завтра, {{ item.time.time }}
        {%- else %}{{ item.time.date }}{% if item.time.time %}, {{ item.time.time }}{% endif %}
        {%- endif %} · {{ item.topic }}</b>{% if item.who %} · {{ item.who }}{% endif %}
    {%- endcase -%}
    {%- assign sep = "" -%}
    {%- capture second -%}
      {%- if item.since and "reply,question" contains item.type %}{{ sep }}ждёт {{ item.since.span }}{% assign sep = " · " %}{% endif -%}
      {%- if due != "" and "risk,money,decision" contains item.type %}{{ sep }}{{ due }}{% assign sep = " · " %}{% endif -%}
      {%- if item.action and "task,meeting" contains item.type %}{{ sep }}{{ item.action }}{% assign sep = " · " %}{% endif -%}
      {%- if item.detail and "task,money,meeting,decision" contains item.type %}{{ sep }}{{ item.detail }}{% assign sep = " · " %}{% endif -%}
      {%- if item.who and "task,fact,risk,decision" contains item.type %}{{ sep }}{{ item.who }}{% assign sep = " · " %}{% endif -%}
      {%- if item.channel %}{{ sep }}
        {%- case item.channel -%}
          {%- when "telegram" %}Telegram{% when "max" %}MAX{% when "whatsapp" %}WhatsApp
          {%- when "mail" %}почта{% when "meeting" %}встреча{% when "task" %}задача
        {%- endcase -%}
        {%- assign sep = " · " -%}
      {%- endif -%}
      {%- if item.quote %}{{ sep }}<i>«{{ item.quote }}»</i>{% assign sep = " · " %}{% endif -%}
      {%- for link in item.links %}{{ sep }}<a href="{{ link.url }}" style="color:#3b82c4">{{ link.label }}</a>{% assign sep = " · " %}{% endfor -%}
    {%- endcapture -%}
    {%- if second != "" %}<br><span style="{{ muted }}">{{ second }}</span>{% endif %}</p>
  {%- endfor -%}
  {%- if section.more > 0 %}{{ nl }}<p style="margin:0 0 12px;{{ muted }}">ещё {{ section.more }}</p>{% endif -%}
{%- endfor -%}
{%- unless quiet -%}
  {%- for source in health.items -%}
    {{ nl }}<p style="margin:20px 0 0;{{ muted }}">{{ health.emoji }} {{ source.source }} не обновлялся {{ source.span }}
    {%- for link in source.links %} · <a href="{{ link.url }}" style="color:#3b82c4">{{ link.label }}</a>{% endfor %}</p>
  {%- endfor -%}
{%- endunless -%}
{{ nl }}</div>
