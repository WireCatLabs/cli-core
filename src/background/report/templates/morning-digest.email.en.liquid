{%- comment -%}
Email HTML with inline CSS: only div, p, b, i, a, br and span survive, with a style attribute and an href to a link
of the view model. No colour on the body: the grey (#8a8a8a) and the link blue (#3b82c4) read on white and on dark.
{%- endcomment -%}
{%- capture nl %}
{% endcapture -%}
{%- assign weekdays = "Monday,Tuesday,Wednesday,Thursday,Friday,Saturday,Sunday" | split: "," -%}
{%- assign weekday = date.weekday | minus: 1 -%}
{%- assign muted = "color:#8a8a8a;font-size:13px" -%}
<div style="max-width:600px;font-family:-apple-system,Segoe UI,Roboto,Arial,sans-serif;font-size:15px">
{{- nl }}<p style="margin:0 0 8px;font-size:19px"><b>{{ emoji }} Digest for {{ weekdays[weekday] }}, {{ date.date }}</b></p>
{%- if summary %}{{ nl }}<p style="margin:0 0 12px">{{ summary }}</p>{% endif -%}
{%- if quiet -%}
  {{ nl }}<p style="margin:0 0 12px">
  {%- if health.items.size > 0 %}Nothing new, but sync needs attention.
  {%- else %}A quiet morning: nothing urgent.{% endif %}</p>
{%- endif -%}
{%- for section in sections -%}
  {{ nl }}<p style="margin:20px 0 8px;font-size:17px"><b>{{ section.emoji }}{{ " " }}
  {%- case section.kind -%}
    {%- when "today" %}Today
    {%- when "decisions" %}Waiting for your decision
    {%- when "money" %}Money
    {%- when "meetings" %}Meetings
    {%- when "projects" %}Projects in motion
    {%- when "mail" %}New mail
  {%- endcase %}</b></p>
  {%- for item in section.items -%}
    {%- capture due -%}
      {%- if item.due -%}
        {%- if item.overdue %}<b>overdue by {{ item.due.span }}</b>
        {%- else %}due {% if item.due.day == "today" %}today{% elsif item.due.day == "tomorrow" %}tomorrow{% else %}{{ item.due.date }}{% endif %}{% if item.due.time %}, {{ item.due.time }}{% endif %}
        {%- endif -%}
      {%- endif -%}
    {%- endcapture -%}
    {{ nl }}<p style="margin:0 0 12px;line-height:1.45">{{ item.emoji }}{{ " " }}
    {%- case item.type -%}
      {%- when "reply" %}<b>{{ item.who }} · {{ item.topic }}</b> — {{ item.action }}
      {%- when "question" %}<b>{{ item.who }}</b> asks: {{ item.action }}
      {%- when "task" %}<b>{{ item.topic }}</b>{% if due != "" %} — {{ due }}{% elsif item.who %} — {{ item.who }}{% endif %}
      {%- when "fact" %}<b>{{ item.topic }}</b>: {{ item.detail }}
      {%- when "risk" %}<b>{{ item.topic }}</b>: {{ item.detail }} → {{ item.action }}
      {%- when "money" %}<b>{{ item.amount.text }} · {{ item.who }} · {{ item.topic }}</b>{% if item.action %} — {{ item.action }}{% endif %}
      {%- when "decision" %}<b>{{ item.topic }}</b> — {% if item.count %}{{ item.count }} {% endif %}{{ item.action }}
      {%- when "meeting" %}<b>
        {%- if item.time.day == "today" %}{{ item.time.time }}
        {%- elsif item.time.day == "yesterday" %}Yesterday
        {%- elsif item.time.day == "tomorrow" %}Tomorrow, {{ item.time.time }}
        {%- else %}{{ item.time.date }}{% if item.time.time %}, {{ item.time.time }}{% endif %}
        {%- endif %} · {{ item.topic }}</b>{% if item.who %} · {{ item.who }}{% endif %}
    {%- endcase -%}
    {%- assign sep = "" -%}
    {%- capture second -%}
      {%- if item.since and "reply,question" contains item.type %}{{ sep }}waiting {{ item.since.span }}{% assign sep = " · " %}{% endif -%}
      {%- if due != "" and "risk,money,decision" contains item.type %}{{ sep }}{{ due }}{% assign sep = " · " %}{% endif -%}
      {%- if item.action and "task,meeting" contains item.type %}{{ sep }}{{ item.action }}{% assign sep = " · " %}{% endif -%}
      {%- if item.detail and "task,money,meeting,decision" contains item.type %}{{ sep }}{{ item.detail }}{% assign sep = " · " %}{% endif -%}
      {%- if item.who and "fact,risk,decision" contains item.type %}{{ sep }}{{ item.who }}{% assign sep = " · " %}{% endif -%}
      {%- if item.who and item.type == "task" and due != "" %}{{ sep }}{{ item.who }}{% assign sep = " · " %}{% endif -%}
      {%- if item.channel %}{{ sep }}
        {%- case item.channel -%}
          {%- when "telegram" %}Telegram{% when "max" %}MAX{% when "whatsapp" %}WhatsApp
          {%- when "mail" %}mail{% when "meeting" %}meeting{% when "task" %}task
        {%- endcase -%}
        {%- assign sep = " · " -%}
      {%- endif -%}
      {%- if item.quote %}{{ sep }}<i>“{{ item.quote }}”</i>{% assign sep = " · " %}{% endif -%}
      {%- for link in item.links %}{{ sep }}<a href="{{ link.url }}" style="color:#3b82c4">{{ link.label }}</a>{% assign sep = " · " %}{% endfor -%}
    {%- endcapture -%}
    {%- if second != "" %}<br><span style="{{ muted }}">{{ second }}</span>{% endif %}</p>
  {%- endfor -%}
  {%- if section.more > 0 %}{{ nl }}<p style="margin:0 0 12px;{{ muted }}">{{ section.more }} more</p>{% endif -%}
  {%- if section.groups.size > 0 %}{{ nl }}<p style="margin:0 0 12px;{{ muted }}">
    {%- for group in section.groups -%}
      {%- unless forloop.first %} · {% endunless -%}
      {%- capture words -%}
        {%- case group.filter -%}
          {%- when "overdue" %}All overdue
          {%- when "today" %}{% if forloop.first %}Due today{% else %}due today{% endif %}
          {%- when "tomorrow" %}{% if forloop.first %}Due tomorrow{% else %}due tomorrow{% endif %}
          {%- when "new" %}{% if forloop.first %}New{% else %}new{% endif %}
        {%- endcase %} ({{ group.count }})
      {%- endcapture -%}
      {%- if group.link %}<a href="{{ group.link.url }}" style="color:#3b82c4">{{ words }}</a>{% else %}{{ words }}{% endif -%}
    {%- endfor -%}
  </p>{%- endif -%}
{%- endfor -%}
{%- for source in health.items -%}
  {{ nl }}<p style="margin:20px 0 0;{{ muted }}">{{ health.emoji }} {{ source.source }}
  {%- if source.account %} ({{ source.account }}){% endif -%}
  {%- case source.reason -%}
    {%- when "sync-failed" %}: sync failing{% if source.since %} since {{ source.since.date }}{% endif %}
    {%- when "no-schedule" %}: no sync schedule
    {%- when "quiet" %}: nothing new {% if source.since %}since {{ source.since.date }}{% else %}for {{ source.span }}{% endif %}
    {%- else %} has not synced for {{ source.span }}
  {%- endcase -%}
  {%- for link in source.links %} · <a href="{{ link.url }}" style="color:#3b82c4">{{ link.label }}</a>{% endfor -%}</p>
{%- endfor -%}
{%- if scope -%}
  {{ nl }}<p style="margin:20px 0 0;{{ muted }}">Viewed over {{ scope.window }}
  {%- for source in scope.sources -%}
    {%- if forloop.first %}: {% else %}, {% endif -%}
    {%- case source.kind -%}
      {%- when "telegram" %}Telegram{% when "max" %}MAX{% when "whatsapp" %}WhatsApp
      {%- when "mail" %}mail{% when "meeting" %}meetings{% when "task" %}tasks
    {%- endcase -%}
    {%- if source.accounts > 1 %} ({{ source.accounts }} {% if source.kind == "mail" %}{% if source.plural == "one" %}mailbox{% else %}mailboxes{% endif %}{% else %}{% if source.plural == "one" %}account{% else %}accounts{% endif %}{% endif %}){% endif -%}
  {%- endfor -%}
  {%- for count in scope.counts -%}
    {%- if forloop.first %} · {% else %}, {% endif -%}
    {{ count.count }} {% case count.kind -%}
      {%- when "chats" %}{% if count.plural == "one" %}chat{% else %}chats{% endif %}
      {%- when "mail" %}{% if count.plural == "one" %}email{% else %}emails{% endif %}
      {%- when "tasks" %}{% if count.plural == "one" %}task{% else %}tasks{% endif %}
      {%- when "meetings" %}{% if count.plural == "one" %}meeting{% else %}meetings{% endif %}
    {%- endcase -%}
  {%- endfor -%}
  </p>
{%- endif -%}
{{ nl }}</div>
