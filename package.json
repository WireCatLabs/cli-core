{
  "name": "@wirecat/cli-core",
  "version": "2.0.0",
  "description": "The messenger-neutral half of a messaging CLI: domain model, message locators, rendering, name resolution, the SQLite seam, the command skeleton and shared read commands, the send guard, run records and the message store",
  "license": "Apache-2.0",
  "author": "Viacheslav Ptsarev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WireCatLabs/cli-core.git"
  },
  "homepage": "https://github.com/WireCatLabs/cli-core#readme",
  "bugs": {
    "url": "https://github.com/WireCatLabs/cli-core/issues"
  },
  "type": "module",
  "wirecat": {
    "stable": [
      ".",
      "./mcp",
      "./start",
      "./testing"
    ],
    "store": {
      "speaks": 78,
      "minCompatible": 78
    }
  },
  "engines": {
    "node": "^22.16.0 || >=24"
  },
  "packageManager": "pnpm@11.28.8",
  "files": [
    "dist",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/testing/**",
    "constants.json",
    "parity.json",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES",
    "docs/search/recipes.json",
    "schemas"
  ],
  "exports": {
    ".": {
      "types": "./dist/entries/main.d.ts",
      "default": "./dist/bundle/index.js"
    },
    "./start": {
      "types": "./dist/entries/start.d.ts",
      "default": "./dist/bundle/start.js"
    },
    "./mcp": {
      "types": "./dist/entries/mcp.d.ts",
      "default": "./dist/bundle/mcp.js"
    },
    "./documents": {
      "types": "./dist/entries/documents.d.ts",
      "default": "./dist/bundle/documents.js"
    },
    "./mail": {
      "types": "./dist/entries/mail.d.ts",
      "default": "./dist/bundle/mail.js"
    },
    "./testing": {
      "types": "./dist/entries/testing.d.ts",
      "default": "./dist/bundle/testing.js"
    },
    "./preload": {
      "types": "./dist/bundle/preload.d.ts",
      "default": "./dist/bundle/preload.js"
    },
    "./parity.json": "./parity.json",
    "./package.json": "./package.json",
    "./schemas/records-envelope.v1.schema.json": "./schemas/records-envelope.v1.schema.json",
    "./schemas/examples/records-business.jsonl": "./schemas/examples/records-business.jsonl"
  },
  "scripts": {
    "build": "tsc --build --force && node scripts/bundle-drizzle.ts && node scripts/bundle-echarts.ts && node scripts/bundle-libraries.ts && node scripts/copy-snowball.ts && node scripts/copy-chart-fonts.ts && node scripts/copy-report-templates.ts && node scripts/bundle-dist.ts",
    "check:dist": "node scripts/check-dist.ts",
    "typecheck": "tsc --build --force --emitDeclarationOnly && tsc -p tsconfig.test.json && tsc -p tsconfig.scripts.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "db:generate": "drizzle-kit generate",
    "db:bundle": "node scripts/bundle-migrations.ts",
    "docs:check": "pnpm build && pnpm docs:check:built",
    "docs:check:built": "node --experimental-strip-types scripts/docs-check.ts && node scripts/search-docs.ts --check && node scripts/standard-docs.ts --check && node scripts/reasons-docs.ts --check",
    "standard:docs": "node scripts/standard-docs.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:slow": "vitest run --reporter=json --outputFile=coverage/tests.json >/dev/null; cli-dev slow-tests",
    "smoke:bun": "bun run scripts/smoke.ts",
    "prepare": "lefthook install || true",
    "secrets:scan": "gitleaks git --no-banner --redact .",
    "prepublishOnly": "pnpm build",
    "schema:check": "scripts/schema/check.sh",
    "schema:render": "node scripts/schema/render.mjs",
    "schema:envelope": "pnpm build && node scripts/records-envelope-schema.mjs && biome format --write schemas/records-envelope.v1.schema.json",
    "parity:seed": "tsc --build && node --experimental-strip-types scripts/parity-seed.ts",
    "parity:render": "node --experimental-strip-types scripts/parity-render.ts",
    "parity:audit": "tsc --build && node --experimental-strip-types scripts/parity-audit.ts",
    "search:docs": "pnpm build && node scripts/search-docs.ts",
    "check:agent-process": "pnpm build && pnpm check:agent-process:built",
    "check:agent-process:built": "node --experimental-strip-types scripts/check-agent-process.ts",
    "standards:check": "node config/wirecat/check.mjs",
    "docs:images": "node docs/images/src/render.ts",
    "docs:lint": "markdownlint-cli2",
    "reasons:docs": "node scripts/reasons-docs.ts",
    "docs:spell": "cspell lint --config cspell.json --no-progress README.md",
    "ci:quick": "pnpm typecheck && vitest run src/cli/command-lint.test.ts",
    "help:examples": "HELP_EXAMPLES_REPORT=1 vitest run scripts/help-examples.test.ts --silent=false"
  },
  "dependencies": {
    "@bomb.sh/tab": "0.0.22",
    "@valibot/to-json-schema": "1.8.0",
    "@wasm-audio-decoders/flac": "0.2.11",
    "@wasm-audio-decoders/ogg-vorbis": "0.1.20",
    "@wirecat/cli-core-sqlite": "1.1.0",
    "@xmldom/xmldom": "0.9.12",
    "chardet": "2.2.0",
    "dictionary-en": "4.0.0",
    "dictionary-es": "4.0.0",
    "disposable-email-domains-js": "1.26.0",
    "fflate": "0.8.3",
    "hast-util-from-html": "2.1.0",
    "hast-util-to-html": "9.0.6",
    "hast-util-to-mdast": "10.1.3",
    "iconv-lite": "0.7.3",
    "image-size": "2.0.4",
    "lossless-json": "4.3.3",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-to-hast": "13.2.2",
    "mdast-util-to-markdown": "2.2.0",
    "micromark-extension-gfm": "3.0.0",
    "mpg123-decoder": "1.0.3",
    "postal-mime": "4.1.4",
    "qrcode-generator": "2.0.4",
    "string-width": "8.3.0",
    "valibot": "1.5.0",
    "word-extractor": "1.0.4",
    "wrap-ansi": "10.0.2",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@cspell/dict-en-gb": "5.0.38",
    "@cspell/dict-es-es": "3.0.9",
    "@cspell/dict-ru_ru": "2.3.4",
    "@huggingface/tokenizers": "0.2.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@napi-rs/canvas": "1.0.13",
    "@resvg/resvg-js": "2.6.2",
    "@types/mdast": "4.0.4",
    "@types/node": "^22.20.5",
    "@types/pg": "8.23.1",
    "@types/pngjs": "6.0.5",
    "@types/ssh2": "1.15.5",
    "@vitest/coverage-v8": "^5.0.5",
    "@wirecat/cli-base": "2.0.0",
    "@wirecat/cli-core-legacy-tags": "npm:@wirecat/cli-core@0.414.0",
    "@wirecat/cli-core-onnx": "1.2.0",
    "ajv": "8.17.1",
    "commander": "15.0.0",
    "cspell": "10.4.0",
    "defuddle": "0.19.6",
    "dictionary-ru": "3.0.0",
    "drizzle-kit": "1.0.0-rc.5",
    "drizzle-orm": "1.0.0-rc.5",
    "echarts": "6.1.0",
    "esbuild": "0.28.2",
    "jsqr": "1.4.0",
    "lefthook": "2.2.2",
    "libphonenumber-js": "1.13.15",
    "linkedom": "0.18.14",
    "liquidjs": "10.30.0",
    "mammoth": "1.13.0",
    "markdownlint-cli2": "0.24.0",
    "mysql2": "3.24.6",
    "ogg-opus-decoder": "1.7.5",
    "pg": "8.23.1",
    "pngjs": "7.0.0",
    "psl": "1.15.0",
    "rolldown": "1.2.15",
    "sherpa-onnx": "2.0.0",
    "ssh2": "1.17.0",
    "tldts": "7.4.19",
    "typescript": "^7.0.2",
    "unpdf": "1.9.1",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@napi-rs/canvas": ">=0.1.69 <2",
    "@wirecat/cli-base": "^2.0.0",
    "commander": "^15.0.0",
    "liquidjs": "^10.30.0",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "ssh2": "^1.17.0"
  },
  "bin": {
    "cli-core-parity": "dist/parity/bin.js"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/server": {
      "optional": true
    },
    "@napi-rs/canvas": {
      "optional": true
    },
    "liquidjs": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "ssh2": {
      "optional": true
    }
  }
}
