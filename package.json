{
  "name": "@leemour/cli-core",
  "version": "0.13.0",
  "description": "The parts every command line tool needs: output modes, terminal rendering, error model, exit codes, credentials, clocks",
  "license": "MIT",
  "author": "Viacheslav Ptsarev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leemour/cli-core.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.20.0",
  "files": [
    "dist",
    "config",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "cli-dev": "dist/dev/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "default": "./dist/http/index.js"
    },
    "./commands": {
      "types": "./dist/commands/index.d.ts",
      "default": "./dist/commands/index.js"
    },
    "./completion": {
      "types": "./dist/completion/index.d.ts",
      "default": "./dist/completion/index.js"
    },
    "./update": {
      "types": "./dist/update/index.d.ts",
      "default": "./dist/update/index.js"
    },
    "./codegen": {
      "types": "./dist/codegen/index.d.ts",
      "default": "./dist/codegen/index.js"
    },
    "./codegen/runtime": {
      "types": "./dist/codegen/runtime.d.ts",
      "default": "./dist/codegen/runtime.js"
    },
    "./release": {
      "types": "./dist/release/index.d.ts",
      "default": "./dist/release/index.js"
    },
    "./skill": {
      "types": "./dist/skill/index.d.ts",
      "default": "./dist/skill/index.js"
    },
    "./biome": "./config/biome.base.json",
    "./tsconfig.base.json": "./config/tsconfig.base.json",
    "./tsconfig.test.json": "./config/tsconfig.test.json",
    "./tsconfig.scripts.json": "./config/tsconfig.scripts.json",
    "./lefthook.yml": "./config/lefthook.yml"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --force --emitDeclarationOnly && tsc -p tsconfig.test.json && tsc -p tsconfig.scripts.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "docs:check": "pnpm build && node dist/dev/bin.js docs-check --ids CLI,MAX,OPS,CORE,SPEC,DOC",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:slow": "vitest run --reporter=json --outputFile=coverage/tests.json >/dev/null; pnpm build >/dev/null && node dist/dev/bin.js slow-tests",
    "smoke:bun": "bun run scripts/smoke.ts",
    "prepare": "lefthook install || true",
    "secrets:scan": "gitleaks git --no-banner --redact .",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "cli-table3": "^0.6.5",
    "env-paths": "^4.0.0",
    "picocolors": "^1.1.1",
    "pino": "^10.3.1",
    "valibot": "^1.5.0"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "2.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^5.0.2",
    "commander": "^15.0.0",
    "lefthook": "^2.1.8",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "commander": ">=15"
  },
  "peerDependenciesMeta": {
    "commander": {
      "optional": true
    }
  }
}
