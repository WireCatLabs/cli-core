{
  "extends": "@wirecat/cli-base/tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    // For the X.Y.Z-dev release, which ships src/; the X.Y.Z users install drops the maps (scripts/release-pair.ts)
    "sourceMap": true,
    "declarationMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/testing/**"]
}
